SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_WEB_CLIENT_ID=
SUPABASE_IOS_CLIENT_ID=

SUPABASE_SERVICE_ROLE_KEY=
# Next.js only exposes browser-visible env vars with this exact prefix —
# same project/values as SUPABASE_URL/SUPABASE_ANON_KEY above, just named
# the way the framework requires. See apps/web/README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ── APK Distribution (pre-Play Store) ──
# Third fallback only: getLatestRelease() reads Supabase Storage
# apk-releases/manifest.json first, then GitHub Releases. These values must
# track whatever the manifest currently advertises, or they lie the moment
# Supabase is unreachable. Mirrored from the live manifest 2026-09-27.
# Releases now ship as GitHub release assets — the Supabase Storage object
# only exists for v1.0.0 (a HEAD on takwa-v1.7.4.apk returns 400).
NEXT_PUBLIC_APK_URL=https://github.com/Imad-Ainine/takwa/releases/download/v1.7.4/takwa-v1.7.4.apk
NEXT_PUBLIC_APK_VERSION=1.7.4
NEXT_PUBLIC_APK_SIZE=257.61 MB
NEXT_PUBLIC_APK_SHA256=
NEXT_PUBLIC_APK_SHA1=
NEXT_PUBLIC_APK_RELEASED_AT=2026-09-26T23:39:07Z
SUPABASE_APK_BUCKET=apk-releases
SENTRY_DSN=
# Chargily Pay V2 — server-side only (checkout proxy /api/payments/checkout)
CHARGILY_SECRET_KEY=

# ── Freemius (SaaS billing — non-Algerian customers) ──
# Required, else every /api/payments/freemius/* route answers
# 503 payments_not_configured. Clearing FREEMIUS_SECRET_KEY is the kill switch.
# Product id: the number in the product's dashboard URL.
FREEMIUS_PRODUCT_ID=
# Keys: Freemius dashboard → View Settings → Integration Keys
# (Publishable = "pk_…" safe for clients; Secret = "sk_…" server-side only —
# never put it in apps/mobile/.env, it is an APK asset).
FREEMIUS_PUBLISHABLE_KEY=
FREEMIUS_SECRET_KEY=
# Plan ids: Development → View Plans → Billing Periods tab (one per plan).
FREEMIUS_MONTHLY_PLAN_ID=
# Optional: comma-separated whitelist of plans the checkout endpoint accepts.
# Defaults to FREEMIUS_MONTHLY_PLAN_ID, so annual plans must be listed here
# before the app can buy them.
FREEMIUS_PLAN_IDS=
# Optional: customer-portal template ({PRODUCT_ID}/{PUBLIC_KEY}/{USER_EMAIL}
# are substituted). Only change it if the dashboard shows a different portal URL.
FREEMIUS_PORTAL_URL=
# Public base URL used to build success/cancel deep-link hops back into the app
# (same value the mobile app calls). Must stay https://takwa-web.vercel.app in
# production; setting it explicitly avoids preview-deployment origins.
TAKWA_WEB_BASE_URL=https://takwa-web.vercel.app
# Shared secret for POST /api/payments/reconcile (sent as x-takwa-admin-secret).
# Must match the value deployed on Vercel; the curl in
# docs/freemius-integration.md uses this same header.
TAKWA_ADMIN_SECRET=

# Webhook URL to register in the Freemius dashboard once the product exists:
#   https://takwa-web.vercel.app/api/payments/freemius/webhook
FREEMIUS_WEBHOOK_URL=

FREEMIUS_API_TOKEN=
