SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_WEB_CLIENT_ID=
SUPABASE_IOS_CLIENT_ID=

# Next.js only exposes browser-visible env vars with this exact prefix —
# same project/values as SUPABASE_URL/SUPABASE_ANON_KEY above, just named
# the way the framework requires. See apps/web/README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_APK_BUCKET=

SENTRY_DSN=
# Monthly support price shown on the payment screen and recorded in local
# payment history, in euros — the currency the Freemius plan bills in.
# Display only; the Freemius plan (web-side FREEMIUS_MONTHLY_PLAN_ID) is what
# actually charges.
FREEMIUS_MONTHLY_EUR=
TAKWA_WEB_BASE_URL=
