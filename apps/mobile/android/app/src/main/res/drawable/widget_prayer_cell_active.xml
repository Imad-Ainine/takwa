<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded gold-tinted pill behind the next prayer's cell — applied by
     PrayerWidgetProvider via setBackgroundResource(); cells that aren't
     "next" get resource 0 (cleared). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="12dp" />
    <solid android:color="@color/widget_highlight_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_highlight_stroke" />
</shape>
