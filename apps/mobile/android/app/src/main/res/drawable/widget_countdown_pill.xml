<?xml version="1.0" encoding="utf-8"?>
<!-- Pill behind the large prayer widget's countdown text, so the "متبقٍ…"
     line reads as a badge rather than loose text over the card. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="@color/widget_highlight_bg" />
    <stroke
        android:width="1dp"
        android:color="@color/widget_highlight_stroke" />
</shape>
