<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared card background for every Takwa home-screen widget (prayer times,
  dua/dhikr/verse of the day). Colors come from widget_colors.xml
  (values/ + values-night/), so this one drawable already adapts to the
  system's light/dark setting — no separate drawable-night variant needed
  for the gradient layers (only the motif bitmap below has one, since a
  vector's own stroke color can't switch by qualifier the way a @color
  reference can, so it's the drawable resource itself that's swapped).

  Three layers, bottom to top:
   1. The base card gradient (unchanged from the original single-shape
      version) — this alone is a full opaque background.
   2. A brand gold→teal sheen at low opacity, using the exact
      AppColorsExtension.cardGradient tint — the same accent wash the
      in-app cards use, not a one-off invented for the widget.
   3. The rub el hizb motif tucked into the bottom-end corner, low opacity,
      behind all real content — a small nod to Islamic geometric art
      without competing with the text on top of it.
   4. The 1dp border, same as before.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/widget_bg_start"
                android:endColor="@color/widget_bg_end" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <gradient
                android:angle="135"
                android:startColor="@color/widget_overlay_gold"
                android:endColor="@color/widget_overlay_teal" />
        </shape>
    </item>
    <item
        android:width="110dp"
        android:height="110dp"
        android:gravity="end|bottom"
        android:end="6dp"
        android:bottom="6dp"
        android:drawable="@drawable/ic_widget_islamic_motif" />
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_border" />
        </shape>
    </item>
</layer-list>
