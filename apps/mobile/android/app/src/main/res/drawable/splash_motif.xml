<?xml version="1.0" encoding="utf-8"?>
<!-- Rub el hizb (8-pointed star) motif behind the splash logo, mirroring the
     gold pattern texture the Home screen paints. Alpha is baked into the
     stroke color (not layer-list android:alpha) so it holds on every API
     level. drawable-night/ overrides with a brighter stroke. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="340dp"
    android:height="340dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <group android:pivotX="60" android:pivotY="60" android:rotation="0">
        <path
            android:pathData="M22,22 L98,22 L98,98 L22,98 Z"
            android:fillColor="#00000000"
            android:strokeColor="#14C8A96E"
            android:strokeWidth="1.5" />
    </group>
    <group android:pivotX="60" android:pivotY="60" android:rotation="45">
        <path
            android:pathData="M22,22 L98,22 L98,98 L22,98 Z"
            android:fillColor="#00000000"
            android:strokeColor="#14C8A96E"
            android:strokeWidth="1.5" />
    </group>
</vector>
