<?xml version="1.0" encoding="utf-8"?>
<!-- Short gold accent rule under the daily-quote widgets' header row —
     the widget-scale echo of the in-app section-header underline. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="2dp" />
    <gradient
        android:angle="0"
        android:startColor="@color/widget_gold"
        android:endColor="@color/widget_teal_tint" />
</shape>
