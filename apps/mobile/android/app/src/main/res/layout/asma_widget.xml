<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 "Asma ul-Husna of the day" widget — one Name of Allah per day from
  the app's own bundled kAsmaData (the same dataset the Asma screen shows),
  picked deterministically by date in DailyQuoteWidgetService. The Name
  sits large in brand gold over a centered rub el hizb motif, its meaning
  below, with the "n/99" position in a teal pill. Filled by
  AsmaOfDayWidgetProvider.kt.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/asma_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/takwa_widget_card_background">

    <TextView
        android:id="@+id/asma_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp"
        android:text="افتح تطبيق تقوى لعرض اسم الله الحسنى"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:visibility="visible" />

    <ImageView
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_islamic_motif" />

    <LinearLayout
        android:id="@+id/asma_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/asma_widget_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:gravity="start"
                android:textColor="@color/widget_gold"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/asma_widget_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_count_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textColor="@color/widget_teal"
                android:textStyle="bold"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="2dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_accent_bar" />

        <TextView
            android:id="@+id/asma_widget_name"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/widget_gold"
            android:textStyle="bold"
            android:textSize="26sp"
            android:maxLines="1"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="26sp" />

        <TextView
            android:id="@+id/asma_widget_meaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.2"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
