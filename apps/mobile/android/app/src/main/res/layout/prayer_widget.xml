<?xml version="1.0" encoding="utf-8"?>
<!--
  Home-screen prayer-times widget (RemoteViews — no custom views, only what
  AppWidgets support: FrameLayout/LinearLayout/TextView).

  Filled in by PrayerWidgetProvider.kt from the JSON PrayerHomeWidgetService
  (Dart) last wrote; nothing here computes a prayer time. Direction (RTL for
  Arabic) is set by the provider on prayer_widget_content, not baked in here.

  Each cell's label/time TextViews are `match_parent` width (not
  wrap_content) with `autoSizeTextType="uniform"` — that gives autosize an
  actual bound to shrink against, so resizing the widget narrower (down to
  minResizeWidth in prayer_widget_info.xml) shrinks the prayer times to fit
  instead of clipping or overflowing the cell.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/takwa_widget_card_background">

    <TextView
        android:id="@+id/prayer_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp"
        android:text="افتح تطبيق تقوى لعرض أوقات الصلاة"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/prayer_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- Date header: Hijri • weekday • Gregorian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/prayer_widget_hijri"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/prayer_widget_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/prayer_widget_gregorian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <!-- A bare <View> is not one of the view classes RemoteViews
             supports inflating remotely (only FrameLayout/LinearLayout/
             RelativeLayout/GridLayout and specific widgets like TextView
             are) — using one here made this widget fail to bind at all
             ("Couldn't add widget"). FrameLayout is supported and gives
             the identical 1dp divider line. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/widget_divider" />

        <!-- 5 prayer cells, evenly spaced -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/prayer_widget_cell_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/prayer_widget_label_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp" />
                <TextView
                    android:id="@+id/prayer_widget_time_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_widget_cell_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/prayer_widget_label_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp" />
                <TextView
                    android:id="@+id/prayer_widget_time_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_widget_cell_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/prayer_widget_label_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp" />
                <TextView
                    android:id="@+id/prayer_widget_time_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_widget_cell_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/prayer_widget_label_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp" />
                <TextView
                    android:id="@+id/prayer_widget_time_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_widget_cell_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/prayer_widget_label_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="8sp"
                    android:autoSizeMaxTextSize="11sp" />
                <TextView
                    android:id="@+id/prayer_widget_time_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold"
                    android:textSize="13sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
