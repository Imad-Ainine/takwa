<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared layout for the "Dua of the Day" and "Dhikr of the Day" home-screen
  widgets — same RemoteViews, filled in differently by
  DuaOfDayWidgetProvider.kt / DhikrOfDayWidgetProvider.kt (both subclass
  DailyQuoteWidgetProviderBase.kt) from whatever JSON
  DailyQuoteWidgetService (Dart) last wrote for that widget. Direction
  (RTL for Arabic) is set by the provider on daily_quote_content.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/daily_quote_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/takwa_widget_card_background">

    <TextView
        android:id="@+id/daily_quote_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/daily_quote_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <!-- emoji + title … count pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/daily_quote_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/daily_quote_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:gravity="start"
                android:textColor="@color/widget_gold"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="1"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeMaxTextSize="12sp" />

            <TextView
                android:id="@+id/daily_quote_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:textColor="@color/widget_teal"
                android:textStyle="bold"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Main quote, vertically centered in the remaining space -->
        <TextView
            android:id="@+id/daily_quote_text"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="6"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="11sp"
            android:autoSizeMaxTextSize="15sp" />

        <TextView
            android:id="@+id/daily_quote_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
