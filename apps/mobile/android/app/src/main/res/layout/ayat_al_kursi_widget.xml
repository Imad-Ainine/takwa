<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2 Ayat al-Kursi widget — fully static content (the text below is
  Quran 2:255, typed once and never data-bound), so it renders correctly
  even on a fresh install before the app has ever opened.
  AyatAlKursiWidgetProvider.kt only wires the tap-to-open PendingIntent.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ayat_kursi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/takwa_widget_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🕌"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:gravity="start"
                android:text="آية الكرسي"
                android:textColor="@color/widget_gold"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="2dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_accent_bar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ ۚ لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ ۚ لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ ۗ مَنْ ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلَّا بِإِذْنِهِ ۚ يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ ۖ وَلَا يُحِيطُونَ بِشَيْءٍ مِنْ عِلْمِهِ إِلَّا بِمَا شَاءَ ۚ وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ ۖ وَلَا يَئُودُهُ حِفْظُهُمَا ۚ وَهُوَ الْعَلِيُّ الْعَظِيمُ"
            android:textColor="@color/widget_text_primary"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.25"
            android:maxLines="8"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="سورة البقرة، آية ٢٥٥"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
