<?xml version="1.0" encoding="utf-8"?>
<!--
  Static picker preview for the 2×2 next-prayer hero widget — a trimmed
  copy of next_prayer_hero_widget.xml with fixed sample content (see
  prayer_widget_preview.xml for why previews exist).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/takwa_widget_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌇"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="المغرب"
            android:textColor="@color/widget_gold"
            android:textStyle="bold"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="06:31"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold"
            android:textSize="26sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_countdown_pill"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="متبقٍ 2 س 47 د"
            android:textColor="@color/widget_gold"
            android:textStyle="bold"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
