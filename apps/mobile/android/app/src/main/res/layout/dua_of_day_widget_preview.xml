<?xml version="1.0" encoding="utf-8"?>
<!--
  Static "widget picker" preview for the dua-of-the-day widget (Android
  12+, used via android:previewLayout in dua_of_day_widget_info.xml). The
  system renders this XML directly — it is never bound to
  DuaOfDayWidgetProvider or real data, so the dua text below is a fixed
  sample, not whatever DailyQuoteWidgetService last picked.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/takwa_widget_card_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🤲"
                android:textSize="15sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:gravity="start"
                android:text="دعاء اليوم"
                android:textColor="@color/widget_gold"
                android:textStyle="bold"
                android:textSize="12sp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="اللهم إني أسألك العافية في الدنيا والآخرة"
            android:textColor="@color/widget_text_primary"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.3"
            android:maxLines="6" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="للعافية والرقية"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>
</FrameLayout>
