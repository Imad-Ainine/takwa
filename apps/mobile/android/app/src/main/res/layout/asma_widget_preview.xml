<?xml version="1.0" encoding="utf-8"?>
<!--
  Static picker preview for the "Asma ul-Husna of the day" widget — a
  trimmed copy of asma_widget.xml with fixed sample content (see
  prayer_widget_preview.xml for why previews exist). The sample pairs one
  of the most familiar Names with its meaning.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/takwa_widget_card_background">

    <ImageView
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_widget_islamic_motif" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✨"
                android:textSize="14sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp"
                android:gravity="start"
                android:text="اسم الله الحسنى اليوم"
                android:textColor="@color/widget_gold"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_count_pill"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="2/99"
                android:textColor="@color/widget_teal"
                android:textStyle="bold"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="2dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_accent_bar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="الرَّحْمَٰنُ"
            android:textColor="@color/widget_gold"
            android:textStyle="bold"
            android:textSize="26sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="ذو الرحمة الواسعة"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
