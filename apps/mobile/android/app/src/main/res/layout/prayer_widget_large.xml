<?xml version="1.0" encoding="utf-8"?>
<!--
  4×3 "large" size variant of the prayer-times widget — same 5 cells as
  prayer_widget.xml (identical ids, so PrayerWidgetProvider's bindContent
  works unchanged) plus a countdown row for the next prayer, filled in by
  PrayerWidgetLargeProvider.kt's bindExtra() override. This is the "live
  countdown bar" variant noted as a future addition in docs/home_widget.md
  since the very first round of this feature — a separate picker entry
  rather than a second layout swapped at runtime, so it shows up as its own
  4×3 widget alongside the compact 4×2 one.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/prayer_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/takwa_widget_card_background">

    <TextView
        android:id="@+id/prayer_widget_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="16dp"
        android:text="افتح تطبيق تقوى لعرض أوقات الصلاة"
        android:textColor="@color/widget_text_primary"
        android:textSize="13sp"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/prayer_widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone">

        <!-- Date header: Hijri • weekday • Gregorian -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/prayer_widget_hijri"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="start"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/prayer_widget_weekday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/widget_text_primary"
                android:textStyle="bold"
                android:textSize="13sp"
                android:maxLines="1" />

            <TextView
                android:id="@+id/prayer_widget_gregorian"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp"
                android:maxLines="1" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@color/widget_divider" />

        <!-- 5 prayer cells, evenly spaced — same ids as prayer_widget.xml -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/prayer_widget_cell_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/prayer_widget_label_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="12sp" />
                <TextView
                    android:id="@+id/prayer_widget_time_0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_widget_cell_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/prayer_widget_label_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="12sp" />
                <TextView
                    android:id="@+id/prayer_widget_time_1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_widget_cell_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/prayer_widget_label_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="12sp" />
                <TextView
                    android:id="@+id/prayer_widget_time_2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_widget_cell_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/prayer_widget_label_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="12sp" />
                <TextView
                    android:id="@+id/prayer_widget_time_3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/prayer_widget_cell_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
                <TextView
                    android:id="@+id/prayer_widget_label_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="12sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="9sp"
                    android:autoSizeMaxTextSize="12sp" />
                <TextView
                    android:id="@+id/prayer_widget_time_4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:gravity="center"
                    android:textColor="@color/widget_text_primary"
                    android:textStyle="bold"
                    android:textSize="15sp"
                    android:maxLines="1"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeMaxTextSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Countdown to next prayer — the extra row this size variant has
             over the compact one. Filled in by
             PrayerWidgetLargeProvider.bindExtra(); hidden whenever there's
             no "next" prayer to count down to (e.g. after Isha, before
             tomorrow's data has been pushed). -->
        <LinearLayout
            android:id="@+id/prayer_widget_countdown"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <TextView
                android:id="@+id/prayer_widget_countdown_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_gold"
                android:textStyle="bold"
                android:textSize="13sp"
                android:maxLines="1" />

            <ProgressBar
                android:id="@+id/prayer_widget_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="8dp"
                android:max="100"
                android:progressTint="@color/widget_gold"
                android:progressBackgroundTint="@color/widget_progress_track" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
