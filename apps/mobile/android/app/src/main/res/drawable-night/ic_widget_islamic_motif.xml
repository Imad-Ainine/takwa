<?xml version="1.0" encoding="utf-8"?>
<!--
  Dark-mode version of the rub el hizb motif — see the base drawable/ copy
  for what this is. Slightly higher alpha reads the same visual weight on
  the darker card as the light version does on white.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <group android:pivotX="60" android:pivotY="60" android:rotation="0">
        <path
            android:pathData="M22,22 L98,22 L98,98 L22,98 Z"
            android:fillColor="#00000000"
            android:strokeColor="#26C8A96E"
            android:strokeWidth="3" />
    </group>
    <group android:pivotX="60" android:pivotY="60" android:rotation="45">
        <path
            android:pathData="M22,22 L98,22 L98,98 L22,98 Z"
            android:fillColor="#00000000"
            android:strokeColor="#26C8A96E"
            android:strokeWidth="3" />
    </group>
</vector>
